# Copy to .env for local development. Never commit .env.
ENVIRONMENT=local
LOG_LEVEL=INFO

# Matches docker-compose.yml. Change the port here and POSTGRES_PORT together if 5432 is taken.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aurora:aurora@localhost:5432/aurora

# Supabase Auth. Local: `supabase start` (from the repo root) serves it on 54321.
# Cloud: https://<project-ref>.supabase.co. Tokens are verified against
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_AUDIENCE=authenticated
# Only for projects still using the legacy HS256 JWT secret. Leave empty otherwise.
SUPABASE_JWT_SECRET=

# Server-only secret key (Supabase: Settings -> API keys -> secret). Needed only to keep photos
# users opt in to keeping for the 3D try-on; leave empty to disable keeping photos.
SUPABASE_SECRET_KEY=
PHOTO_BUCKET=profile-photos

# Comma-separated: web app origin, extension origin (chrome-extension://<id> in production).
CORS_ORIGINS=http://localhost:3000
# Local dev only: allow any unpacked Chrome or Firefox extension. Leave unset in production.
CORS_ORIGIN_REGEX=^(chrome-extension://[a-p]{32}|moz-extension://[0-9a-f-]{36})$
